# Copy to .env and fill in. Values come from the Discord Developer Portal
# (https://discord.com/developers/applications -> your app).

# OAuth2 / Activity credentials
DISCORD_CLIENT_ID=your_application_id
DISCORD_CLIENT_SECRET=your_client_secret

# Server
PORT=3001

# Optional: path to a large word/clue CSV (Date,Word,Clue,Difficulty or Word,Clue,Difficulty).
# Defaults to server/data/clues.csv, then server/data/words.sample.csv.
# CLUES_CSV=./server/data/clues.csv
